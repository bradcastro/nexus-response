# Server
PORT=3000
# 1 (default) = seed demo fleets + ~150 historical incidents at boot; 0 = start empty, run legacy pollers
DEMO_MODE=1

# Storage: leave empty for in-memory (zero setup). Set for PostgreSQL (JSONB incident store).
DATABASE_URL=

# Webhook HMAC-SHA256 secrets (optional; verification is skipped when unset)
MOTIVE_WEBHOOK_SECRET=
SAMSARA_WEBHOOK_SECRET=
GEOTAB_WEBHOOK_SECRET=
LYTX_WEBHOOK_SECRET=
GENERIC_WEBHOOK_SECRET=

# Optional: look up VINs not in the offline table via NHTSA vPIC (2.5s timeout, graceful fallback)
VIN_ONLINE=0

# Legacy pollers (only run when DEMO_MODE=0 or ENABLE_LEGACY_POLLERS=1, and the key is set)
ENABLE_LEGACY_POLLERS=0
MOTIVE_API_KEY=
SAMSARA_API_KEY=

# Optional map keys served at /api/config
GOOGLE_MAPS_KEY=
MAPBOX_TOKEN=
